diff --git a/drivers/net/mlx5/rte_pmd_mlx5.h b/drivers/net/mlx5/rte_pmd_mlx5.h
index ee5c4a0..623f9e6 100644
--- a/drivers/net/mlx5/rte_pmd_mlx5.h
+++ b/drivers/net/mlx5/rte_pmd_mlx5.h
@@ -5,6 +5,7 @@
 #ifndef RTE_PMD_PRIVATE_MLX5_H_
 #define RTE_PMD_PRIVATE_MLX5_H_
 
+#include <stddef.h>
 #include <stdint.h>
 
 #include <rte_byteorder.h>
@@ -250,6 +251,71 @@ int rte_pmd_mlx5_flow_engine_set_mode(enum rte_pmd_mlx5_flow_engine_mode mode, u
 __rte_experimental
 int rte_pmd_mlx5_external_sq_disable(uint16_t port_id, uint32_t sq_num);
 
+#ifdef RTE_EXEC_ENV_LINUX
+/**
+ * Register DMA-BUF-backed external memory for mlx5 mbuf DMA.
+ *
+ * Call in the primary process with IOVA mode VA. The caller supplies the
+ * CPU virtual address of a mapping of the same bytes as the DMA-BUF range.
+ * The export must permit the bidirectional DMA requested by Linux RDMA.
+ * Keep the CPU mapping live and prevent overlapping registrations until
+ * unmap completes. The verbs registration retains the backing DMA-BUF.
+ * The libibverbs dlopen glue build returns -ENOTSUP for this method.
+ *
+ * @param port_id
+ *   mlx5 Ethernet port. The registration is shared by ports using its PD.
+ * @param addr
+ *   Start of the external CPU mapping used in mbufs and as its HCA IOVA.
+ * @param len
+ *   Number of bytes to register.
+ * @param fd
+ *   DMA-BUF descriptor.
+ * @param offset
+ *   Byte offset into the DMA-BUF matching addr, with the same in-page offset.
+ * @return
+ *   0 on success, a negative errno value otherwise and rte_errno is set.
+ */
+__rte_experimental
+int rte_pmd_mlx5_dmabuf_map(uint16_t port_id, void *addr, size_t len, int fd,
+			   uint64_t offset);
+
+/**
+ * Release a DMA-BUF registration for the exact address and length.
+ *
+ * The caller must drain all queues using the buffer and prevent new
+ * submissions before unmap. Serialize with port close and device removal.
+ *
+ * @param port_id
+ *   The mlx5 port used to register the buffer.
+ * @param addr
+ *   Start address supplied to the map call.
+ * @param len
+ *   Length supplied to the map call.
+ * @return
+ *   0 on success, a negative errno value otherwise and rte_errno is set.
+ */
+__rte_experimental
+int rte_pmd_mlx5_dmabuf_unmap(uint16_t port_id, void *addr, size_t len);
+
+/**
+ * Request a send CQE on the last WQE of each productive TX doorbell.
+ *
+ * Call from the primary process after starting an ordinary TX queue and
+ * before its first TX burst. The queue and port must not be in use while
+ * configuring it. The queue continues to use the configured CQ capacity.
+ * A full CQ applies TX backpressure until polling drains it.
+ *
+ * @param port_id
+ *   Ethernet port identifier.
+ * @param queue_id
+ *   Started TX queue identifier.
+ * @return
+ *   Zero on success or a negative errno value.
+ */
+__rte_experimental
+int rte_pmd_mlx5_enable_tx_burst_completion(uint16_t port_id, uint16_t queue_id);
+#endif
+
 #ifdef __cplusplus
 }
 #endif
