ceipt, then send supplemental archive for transfer evidence if needed. Receiver uses unique filenames and returns SHA256/bytes. No overwrite of prior results.\"}"}, {"utc": "2026-11-08T22:32:57.448134+00:00", "sender": "spark-7e64", "text": "{\"run_id\": \"directional-split-20261108T222809Z-13438dc9\", \"kind\": \"RESULTS_DONE\", \"test_id\": \"directional-split-20261108T222809Z-13438dc9-r1\", \"results\": [{\"path\": 1, \"rows\": [{\"section\": \"combined\", \"raw\": \" 65536      2815906          0.00               102.16 \\t\\t   0.194856\", \"gbps\": 102.16}, {\"section\": \"local_tx\", \"raw\": \" 65536      2815906          0.00               92.27  \\t\\t   0.175995\", \"gbps\": 92.27}, {\"section\": \"remote_tx_local_rx\", \"raw\": \" 65536      301782           0.00               9.89   \\t\\t   0.018861\", \"gbps\": 9.89}], \"stdout\": \"20261108T223226Z-spark-7e64-r1-p1-client-a622e2.stdout\", \"metadata\": \"20261108T223226Z-spark-7e64-r1-p1-client-a622e2.json\"}, {\"path\": 2, \"rows\": [{\"section\": \"combined\", \"raw\": \" 65536      2815901          0.00               102.16 \\t\\t   0.194855\", \"gbps\": 102.16}, {\"section\": \"local_tx\", \"raw\": \" 65536      2815901          0.00               92.27  \\t\\t   0.175994\", \"gbps\": 92.27}, {\"section\": \"remote_tx_local_rx\", \"raw\": \" 65536      301781           0.00               9.89   \\t\\t   0.018861\", \"gbps\": 9.89}], \"stdout\": \"20261108T223226Z-spark-7e64-r1-p2-client-21aff7.stdout\", \"metadata\": \"20261108T223226Z-spark-7e64-r1-p2-client-21aff7.json\"}], \"exit_codes\": [0, 0]}"}, {"utc": "2026-11-08T22:32:57.645605+00:00", "sender": "spark-28a3", "text": "{\"run_id\": \"directional-split-20261108T222809Z-13438dc9\", \"kind\": \"RESULTS\", \"test_id\": \"directional-split-20261108T222809Z-13438dc9-r1\", \"results\": [{\"path\": 1, \"exit_code\": 0, \"log\": \"/home/keshav/Documents/ocs-transport/rdma-results/directional-split-20261108T222809Z-13438dc9/directional-split-20261