+#ifdef RTE_EXEC_ENV_LINUX
+int
+mlx5_common_dev_dmabuf_map(struct mlx5_common_device *dev, void *addr,
+			  size_t len, int fd, uint64_t offset)
+{
+	const struct rte_memseg_list *msl;
+	struct mlx5_mr *mr;
+	int ret;
+
+	if (addr == NULL || !len || len > UINTPTR_MAX - (uintptr_t)addr ||
+	    fd < 0 || len > UINT64_MAX - offset) {
+		rte_errno = EINVAL;
+		return -rte_errno;
+	}
+	msl = rte_mem_virt2memseg_list(addr);
+	if (msl != NULL && !msl->external) {
+		rte_errno = EINVAL;
+		return -rte_errno;
+	}
+	mr = mlx5_create_mr_dmabuf(dev->pd, addr, len, fd, offset);
+	if (mr == NULL)
+		return -rte_errno;
+	ret = mlx5_external_mr_insert(dev, mr);
+	if (ret < 0) {
+		mlx5_mr_free(mr, dev->mr_scache.dereg_mr_cb);
+		rte_errno = -ret;
+	}
+	return ret;
+}
+
+int
+mlx5_common_dev_dmabuf_unmap(struct mlx5_common_device *dev, void *addr,
+			    size_t len)
+{
+	struct mlx5_mr_share_cache *cache = &dev->mr_scache;
+	struct mr_cache_entry entry;
+	struct mlx5_mr *mr;
+	int ret;
+
+	rte_rwlock_write_lock(&cache->rwlock);
+	mr = mlx5_mr_lookup_list(cache, &entry, (uintptr_t)addr);
+	if (mr == NULL || !mr->dmabuf || mr->pmd_mr.addr != addr ||
+	    mr->pmd_mr.len != len) {
+		ret = -EINVAL;
+	} else {
+		ret = mlx5_common_verbs_dereg_mr_checked(&mr->pmd_mr);
+		if (ret == 0)
+			mlx5_external_mr_remove(cache, mr);
+	}
+	rte_rwlock_write_unlock(&cache->rwlock);
+	if (ret == 0)
+		mlx5_free(mr);
+	else
+		rte_errno = -ret;
+	return ret;
+}
+#endif
