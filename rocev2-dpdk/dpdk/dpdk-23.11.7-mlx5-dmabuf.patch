+int
+rte_pmd_mlx5_enable_tx_burst_completion(uint16_t port_id, uint16_t queue_id)
+{
+	struct rte_eth_dev *dev;
+	struct mlx5_priv *priv;
+	struct mlx5_txq_data *txq;
+
+	if (!rte_eth_dev_is_valid_port(port_id))
+		return -ENODEV;
+	dev = &rte_eth_devices[port_id];
+	if (dev->dev_ops != &mlx5_dev_ops ||
+	    rte_eal_process_type() != RTE_PROC_PRIMARY)
+		return -ENOTSUP;
+	if (queue_id >= dev->data->nb_tx_queues ||
+	    dev->data->tx_queue_state[queue_id] != RTE_ETH_QUEUE_STATE_STARTED)
+		return -EINVAL;
+	priv = dev->data->dev_private;
+	txq = (*priv->txqs)[queue_id];
+	if (txq == NULL)
+		return -EINVAL;
+	if (txq->offloads & RTE_ETH_TX_OFFLOAD_SEND_ON_TIMESTAMP)
+		return -ENOTSUP;
+	txq->burst_completion = 1;
+	return 0;
+}
+#endif
