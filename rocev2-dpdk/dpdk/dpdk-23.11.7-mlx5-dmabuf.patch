 /**
  * Deregister mr. Given the mlx5 pmd MR - deregister the MR
  *
diff --git a/drivers/common/mlx5/mlx5_common.c b/drivers/common/mlx5/mlx5_common.c
index ca8543e..5188515 100644
--- a/drivers/common/mlx5/mlx5_common.c
+++ b/drivers/common/mlx5/mlx5_common.c
@@ -1068,6 +1068,74 @@ mlx5_common_dev_remove(struct rte_device *eal_dev)
 	return ret;
 }
 
+static bool
+mlx5_external_mr_conflict(struct mlx5_mr_share_cache *cache,
+			 const struct mlx5_mr *mr)
+{
+	uintptr_t start = (uintptr_t)mr->pmd_mr.addr;
+	uintptr_t end = start + mr->pmd_mr.len;
+	struct mlx5_mr *other;
+
+	LIST_FOREACH(other, &cache->mr_list, mr) {
+		uintptr_t other_start = (uintptr_t)other->pmd_mr.addr;
+
+		if ((mr->dmabuf || other->dmabuf) && other->ms_n &&
+		    start < other_start + other->pmd_mr.len && other_start < end)
+			return true;
+	}
+	return false;
+}
+
+static int
+mlx5_external_mr_insert(struct mlx5_common_device *dev, struct mlx5_mr *mr)
+{
+	struct mlx5_mr_share_cache *cache = &dev->mr_scache;
+	struct mlx5_mr_btree *bt = &cache->cache;
+	int ret;
+
+try_insert:
+	rte_rwlock_write_lock(&cache->rwlock);
+	if (mlx5_external_mr_conflict(cache, mr)) {
+		rte_rwlock_write_unlock(&cache->rwlock);
+		return -EEXIST;
+	}
+	if (bt->len == bt->size) {
+		uint32_t size = bt->size + 1;
+
+		MLX5_ASSERT(size > bt->size);
+		/*
+		 * Avoid deadlock (numbers show the sequence of events):
+		 *    mlx5_mr_create_primary():
+		 *        1) take EAL memory lock
+		 *        3) take MR lock
+		 *    this function:
+		 *        2) take MR lock
+		 *        4) take EAL memory lock while allocating the new cache
+		 * Releasing the MR lock before step 4
+		 * allows another thread to execute step 3.
+		 */
+		rte_rwlock_write_unlock(&cache->rwlock);
+		ret = mlx5_mr_expand_cache(cache, size, dev->dev->numa_node);
+		if (ret < 0)
+			return ret;
+		goto try_insert;
+	}
+	ret = mlx5_mr_insert_cache(cache, mr);
+	if (ret == 0)
+		LIST_INSERT_HEAD(&cache->mr_list, mr, mr);
+	rte_rwlock_write_unlock(&cache->rwlock);
+	return ret == 0 ? 0 : -ENOSPC;
+}
+
+static void
+mlx5_external_mr_remove(struct mlx5_mr_share_cache *cache, struct mlx5_mr *mr)
+{
+	LIST_REMOVE(mr, mr);
+	mlx5_mr_rebuild_cache(cache);
+	/* Writer unlock publishes the invalidation to the per-queue caches. */
+	++cache->dev_gen;
+}
