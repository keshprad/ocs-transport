+static struct mlx5_mr *
+mlx5_alloc_mr_ext(int socket_id)
+{
+	struct mlx5_mr *mr;
+
+	mr = mlx5_malloc(MLX5_MEM_RTE | MLX5_MEM_ZERO,
+			 RTE_ALIGN_CEIL(sizeof(*mr), RTE_CACHE_LINE_SIZE),
+			 RTE_CACHE_LINE_SIZE, socket_id);
+	if (mr != NULL) {
+		mr->ms_n = 1;
