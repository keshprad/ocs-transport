+int
+mlx5_common_verbs_reg_dmabuf_mr(void *pd, void *addr, size_t len, int fd,
+			      uint64_t offset, struct mlx5_pmd_mr *pmd_mr)
+{
+#if defined(HAVE_MLX5_IBV_REG_DMABUF_MR) && !defined(RTE_IBVERBS_LINK_DLOPEN)
+	struct ibv_mr *mr;
+
+	errno = 0;
+	mr = ibv_reg_dmabuf_mr(pd, offset, len, (uintptr_t)addr, fd,
+			     IBV_ACCESS_LOCAL_WRITE);
+	if (mr == NULL)
+		return errno == 0 ? -EIO : -errno;
+	*pmd_mr = (struct mlx5_pmd_mr) {
+		.lkey = mr->lkey,
+		.addr = addr,
+		.len = len,
+		.obj = mr,
+	};
+	return 0;
+#else
+	RTE_SET_USED(pd);
+	RTE_SET_USED(addr);
+	RTE_SET_USED(len);
+	RTE_SET_USED(fd);
+	RTE_SET_USED(offset);
+	RTE_SET_USED(pmd_mr);
+	return -ENOTSUP;
+#endif
+}
+
+int
+mlx5_common_verbs_dereg_mr_checked(struct mlx5_pmd_mr *pmd_mr)
+{
+	int ret = mlx5_glue->dereg_mr(pmd_mr->obj);
+
+	return ret > 0 ? -ret : ret;
+}
